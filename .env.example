DATABASE_URL=mysql://user:password@localhost:3306/customwebproject_kttravel_db
PORT=3000
JWT_SECRET=
STRIPE_SECRET=
# Temporary local-testing convenience — bypasses 2FA on /auth/login when true.
# Must be false (or removed) before going live.
DISABLE_2FA=false
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
WEB_APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
# Folder for uploaded images. In production point this at a PERSISTENT location
# (not inside the deployed code), otherwise uploads vanish on every redeploy.
# Default: ./uploads
UPLOADS_DIR=./uploads
